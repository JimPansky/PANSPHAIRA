{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pansphaira.invalid/portable-runtime/v1",
  "$comment": "Shared shape contract only. Valid identity is not observation, readiness, source rights or an execution grant. One led PAN contract; KS consumes this same immutable schema.",
  "$ref": "#/$defs/RuntimeIdentity",
  "$defs": {
    "Commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "ScopeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "RuntimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "componentId",
        "sourceCommit",
        "sourceTree",
        "imageDigest",
        "architecture",
        "productVersion",
        "runtime",
        "contractVersion",
        "instanceId",
        "tenantId",
        "generation",
        "authorityProfile",
        "effectiveRights",
        "configurationDigest",
        "templateDigest",
        "policyDigest",
        "networkDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "pansphaira.portable-runtime/identity/v1"
        },
        "componentId": {
          "enum": [
            "pansphaira-local-demo",
            "kaleidosphere-bi-agent"
          ]
        },
        "sourceCommit": {
          "$ref": "#/$defs/Commit"
        },
        "sourceTree": {
          "$ref": "#/$defs/Commit"
        },
        "imageDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "architecture": {
          "const": "x86_64"
        },
        "productVersion": {
          "$ref": "#/$defs/Version"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "enum": [
                "node",
                "superset"
              ]
            },
            "version": {
              "$ref": "#/$defs/Version"
            }
          }
        },
        "contractVersion": {
          "const": "1.0.0"
        },
        "instanceId": {
          "$ref": "#/$defs/ScopeId"
        },
        "tenantId": {
          "$ref": "#/$defs/ScopeId"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authorityProfile": {
          "const": "SAFE_GUIDED"
        },
        "effectiveRights": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "configurationDigest": {
          "$ref": "#/$defs/Digest"
        },
        "templateDigest": {
          "$ref": "#/$defs/Digest"
        },
        "policyDigest": {
          "$ref": "#/$defs/Digest"
        },
        "networkDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "componentId": {
                "const": "pansphaira-local-demo"
              }
            },
            "required": [
              "componentId"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "runtime": {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "node"
                  }
                }
              },
              "effectiveRights": {
                "type": "array",
                "items": {
                  "enum": [
                    "demo.status.read",
                    "demo.provider.bound.read",
                    "demo.governed.effect"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "componentId": {
                "const": "kaleidosphere-bi-agent"
              }
            },
            "required": [
              "componentId"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "runtime": {
                "type": "object",
                "properties": {
                  "name": {
                    "const": "node"
                  }
                }
              },
              "effectiveRights": {
                "type": "array",
                "items": {
                  "enum": [
                    "bi.catalog.read",
                    "bi.query.bound.read",
                    "bi.drilldown.bound.read"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
